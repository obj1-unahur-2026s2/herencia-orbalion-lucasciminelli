import orbalion.*

describe "Tests checkpoint 1"{

    test "Test 1: Validar rol de entrenador" {
        assert.throwsExceptionWithMessage(
            "Rol no homologado por la FOZ",
            { new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = "Capitan") }
        )
    }

    test "Test 2:equipo lumínico con radiación > 5000 y sin tecnologías activas → su energía total es su energía base "{
        const equipoLuminico = new EquipoLuminico(nombre= "Equipo Luminico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = false) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeRadiacionCapturada=5001, cristalesSolaresAmplificadores=[]);
        assert.equals(1000, equipoLuminico.energiaTotal());
    }

    test "Test 3: equipo lumínico con radiación < 5000 → obtiene el bono del 10%"{
        const equipoLuminico = new EquipoLuminico(nombre= "Equipo Luminico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = false) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeRadiacionCapturada=4999, cristalesSolaresAmplificadores=[]);
        assert.equals(1100, equipoLuminico.energiaTotal());
    }

    test "Test 4: Un equipo sintético con 6 módulos → aplica correctamente la penalización del 20%"{
        const equipoSintetico = new EquipoSintetico(nombre= "Equipo Sintetico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = false) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeProcesamientoCentral=10, cantidadDeModulosActivos=6, estaCertificadoComoUnidadEstableDeCompeticion=true);
        assert.equals(800, equipoSintetico.energiaTotal());
    }

    test "Test 5: Un equipo sintético 4 módulos y 2 tecnologías complementarias → suma correctamente los valores energéticos."{
        const equipoSintetico = new EquipoSintetico(nombre= "Equipo Sintetico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeProcesamientoCentral=10, cantidadDeModulosActivos=4, estaCertificadoComoUnidadEstableDeCompeticion=true);
        assert.equals(1800, equipoSintetico.energiaTotal());
    }
}

describe "Tests checkopint 2"{

    test "Estratega cuántico con 12 ciclos y precisión 90 → es de élite galáctica"{
        const entrenador = new Entrenador(cantidadCiclosSolaresDeExperiencia = 12, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 90, rol = estrategaCuantico);
        assert.that(entrenador.esEliteGalactico())
    }
    test "Arquitecto de energía con 11 ciclos pero sin sintonía → no es de élite."{
        const entrenador = new Entrenador(cantidadCiclosSolaresDeExperiencia = 11, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = arquitectoEnergia);
        assert.notThat(entrenador.esEliteGalactico())
    }
    test "Guía mental con 15 ciclos → siempre es de élite."{
        const entrenador = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        assert.that(entrenador.esEliteGalactico())
    }
}

describe "Tests checkpoint 3"{

    test "Equipo lumínico con 3 cristales, entrenador de élite y una tecnología activa → es de prestigio universal"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoLuminico = new EquipoLuminico(nombre= "Equipo Luminico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador=entrenadorEliteGalactica, nivelDeRadiacionCapturada=4999, cristalesSolaresAmplificadores=["Cristal 1", "Cristal 2", "Cristal 3"])
        
        assert.that(equipoLuminico.esDePrestigioUniversal())
    }

    test "Equipo sintético certificado con 4 módulos y todas las tecnologías activas → es de prestigio"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoSintetico = new EquipoSintetico(nombre= "Equipo Sintetico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeProcesamientoCentral=10, cantidadDeModulosActivos=4, estaCertificadoComoUnidadEstableDeCompeticion=true);
        assert.that(equipoSintetico.esDePrestigioUniversal())
    }

    test "Equipo sintético certificado con 3 módulos y todas las tecnologías activas → no es de prestigio"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoSintetico = new EquipoSintetico(nombre= "Equipo Sintetico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeProcesamientoCentral=10, cantidadDeModulosActivos=3, estaCertificadoComoUnidadEstableDeCompeticion=true);
        assert.notThat(equipoSintetico.esDePrestigioUniversal())
    }
    
    test "Equipo sintético certificado con 2 módulos y todas las tecnologías activas → no es de prestigio"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoSintetico = new EquipoSintetico(nombre= "Equipo Sintetico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeProcesamientoCentral=10, cantidadDeModulosActivos=2, estaCertificadoComoUnidadEstableDeCompeticion=true);
        assert.notThat(equipoSintetico.esDePrestigioUniversal())
    }
    test "Equipo sintético certificado con 4 módulos y no todas las tecnologías activas → no es de prestigio"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoSintetico = new EquipoSintetico(nombre= "Equipo Sintetico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = false), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeProcesamientoCentral=10, cantidadDeModulosActivos=4, estaCertificadoComoUnidadEstableDeCompeticion=true);
        assert.notThat(equipoSintetico.esDePrestigioUniversal())
    }
     test "Equipo sintético no certificado con 4 módulos y todas las tecnologías activas → no es de prestigio"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoSintetico = new EquipoSintetico(nombre= "Equipo Sintetico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador= new Entrenador(cantidadCiclosSolaresDeExperiencia = 10, estaEnSintoniaConSuEquipo = true, nivelDePrecisionEstrategica = 10, rol = estrategaCuantico), nivelDeProcesamientoCentral=10, cantidadDeModulosActivos=4, estaCertificadoComoUnidadEstableDeCompeticion=false);
        assert.notThat(equipoSintetico.esDePrestigioUniversal())
    }
    

    test "Equipo lumínico con 2 cristales, entrenador de élite y una tecnología activa → no es de prestigio universal"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoLuminico = new EquipoLuminico(nombre= "Equipo Luminico 1", nivelDeEnergiaBase=1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador=entrenadorEliteGalactica, nivelDeRadiacionCapturada=4999, cristalesSolaresAmplificadores=["Cristal 1", "Cristal 2"])
        
        assert.notThat(equipoLuminico.esDePrestigioUniversal())
    }
}

describe "Tests checkpoint 4"{

    test "Equipo etérico con 3 portales, fluctuación 80 y 2 tecnologías activas → es de prestigio universal"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoEterico = new EquipoEterico(nombre= "Equipo eterico 1", nivelDeEnergiaBase= 1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador=entrenadorEliteGalactica, nivelDeFluctuacionDimensional = 80, cantidadDePortalesEnergeticosAbiertos = 3);

        assert.that(equipoEterico.esDePrestigioUniversal())
    }

    test "Verificar que el incremento del 15% se aplica correctamente"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoEterico = new EquipoEterico(nombre= "Equipo eterico 1", nivelDeEnergiaBase= 1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador=entrenadorEliteGalactica, nivelDeFluctuacionDimensional = 80, cantidadDePortalesEnergeticosAbiertos = 3);

        assert.equals(2070, equipoEterico.energiaTotal())
    }

    test "Verificar que un equipo etérico que no cumple las condiciones **no** suma el 15%"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoEterico = new EquipoEterico(nombre= "Equipo eterico 1", nivelDeEnergiaBase= 1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador=entrenadorEliteGalactica, nivelDeFluctuacionDimensional = 80, cantidadDePortalesEnergeticosAbiertos = 1);

        assert.equals(1800, equipoEterico.energiaTotal())
    }
    test "Verificar que un equipo etérico que no cumple las condiciones **no** suma el 15% 2"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoEterico = new EquipoEterico(nombre= "Equipo eterico 1", nivelDeEnergiaBase= 1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador=entrenadorEliteGalactica, nivelDeFluctuacionDimensional = 74, cantidadDePortalesEnergeticosAbiertos = 3);

        assert.equals(1800, equipoEterico.energiaTotal())
    }
     test "Verificar que un equipo etérico que no cumple las condiciones **no** suma el 15% 3"{
        const entrenadorEliteGalactica = new Entrenador(cantidadCiclosSolaresDeExperiencia = 15, estaEnSintoniaConSuEquipo = false, nivelDePrecisionEstrategica = 90, rol = guiaMental);
        const equipoEterico = new EquipoEterico(nombre= "Equipo eterico 1", nivelDeEnergiaBase= 1000, tecnologiasComplementarias = #{ new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 300, activa = true), new Tecnologia(nombre = "Núcleo gravitacional", valorEnergetico = 500, activa = true) }, entrenador=entrenadorEliteGalactica, nivelDeFluctuacionDimensional = 75, cantidadDePortalesEnergeticosAbiertos = 3);

        assert.equals(1800, equipoEterico.energiaTotal())
    }
}